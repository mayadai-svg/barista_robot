<?xml version="1.0"?>
<robot name="barista_robot">

        <material name="blue">
            <color rgba="0.0 0.0 1.0 1"/>
        </material>

        <material name="black">
            <color rgba="0.0 0.0 0.0 1"/>
        </material>

        <material name="grey">
            <color rgba="0.75 0.75 0.75 1"/>
        </material>

    <!-- Base Link -->
    <link name="base_link">
    </link>

    <!-- Body -->

    <link name="main_body">
        <visual>
            <geometry>
                <cylinder radius="0.178" length="0.155"/>
            </geometry>
            <material name="blue"/>
        </visual>
        <collision>
            <geometry>
                <cylinder radius="0.178" length="0.155"/>
            </geometry>
        </collision>
        <inertial>
            <mass value="0.2"/>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <inertia ixx="0.0019846" ixy="0" ixz="0" iyy="0.0019846" iyz="0" izz="0.0031684"/>
        </inertial>
    </link>

    <joint name="base_link_to_main_joint" type="fixed">
        <origin rpy="0 0 0" xyz="0 0 0" />
        <parent link="base_link" />
        <child link="main_body" />
    </joint>

    <link name="cup_holder_tray">
        <visual>
            <geometry>
                <cylinder radius="0.16" length=".09"/>
            </geometry>
            <material name="blue"/>
        </visual>
        <collision>
            <geometry>
                <cylinder radius="0.16" length=".09"/>
            </geometry>
        </collision>
        <inertial>
            <mass value="0.05"/>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <inertia ixx="0.00035375" ixy="0" ixz="0" iyy="0.00035375" iyz="0" izz="0.00064"/>
        </inertial>
    </link>

    <joint name="main_link_to_cup_joint" type="fixed">
        <origin rpy="0 0 0" xyz="0 0 0.3425" />
        <parent link="main_body" />
        <child link="cup_holder_tray" />
    </joint>

    <link name="standoff_rod_1">
        <visual>
            <geometry>
                <cylinder radius=".01" length=".220"/>
            </geometry>
            <material name="grey"/>
        </visual>
        <collision>
            <geometry>
                <cylinder radius=".01" length=".220"/>
            </geometry>
        </collision>
        <inertial>
            <mass value="0.02"/>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <inertia ixx="0.00008117" ixy="0" ixz="0" iyy="0.00008117" iyz="0" izz="0.000001"/>
        </inertial>
    </link>

    <joint name="main_link_to_rod1_joint" type="fixed">
        <origin rpy="0 0 0" xyz="0.05 0.12 0.1875" />
        <parent link="main_body" />
        <child link="standoff_rod_1" />
    </joint>

    <link name="standoff_rod_2">
        <visual>
            <geometry>
                <cylinder radius=".01" length=".220"/>
            </geometry>
            <material name="grey"/>
        </visual>
        <collision>
            <geometry>
                <cylinder radius=".01" length=".220"/>
            </geometry>
        </collision>
        <inertial>
            <mass value="0.02"/>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <inertia ixx="0.00008117" ixy="0" ixz="0" iyy="0.00008117" iyz="0" izz="0.000001"/>
        </inertial>
    </link>

    <joint name="main_link_to_rod2_joint" type="fixed">
        <origin rpy="0 0 0" xyz="-0.05 0.12 0.1875" />
        <parent link="main_body" />
        <child link="standoff_rod_2" />
    </joint>

    <link name="standoff_rod_3">
        <visual>
            <geometry>
                <cylinder radius=".01" length=".220"/>
            </geometry>
            <material name="grey"/>
        </visual>
        <collision>
            <geometry>
                <cylinder radius=".01" length=".220"/>
            </geometry>
        </collision>
        <inertial>
            <mass value="0.02"/>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <inertia ixx="0.00008117" ixy="0" ixz="0" iyy="0.00008117" iyz="0" izz="0.000001"/>
        </inertial>
    </link>

    <joint name="main_link_to_rod3_joint" type="fixed">
        <origin rpy="0 0 0" xyz="-0.05 -0.12 0.1875" />
        <parent link="main_body" />
        <child link="standoff_rod_3" />
    </joint>

    <link name="standoff_rod_4">
        <visual>
            <geometry>
                <cylinder radius=".01" length=".220"/>
            </geometry>
            <material name="grey"/>
        </visual>
        <collision>
            <geometry>
                <cylinder radius=".01" length=".220"/>
            </geometry>
        </collision>
        <inertial>
            <mass value="0.02"/>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <inertia ixx="0.00008117" ixy="0" ixz="0" iyy="0.00008117" iyz="0" izz="0.000001"/>
        </inertial>
    </link>

    <joint name="main_link_to_rod4_joint" type="fixed">
        <origin rpy="0 0 0" xyz="0.05 -0.12 0.1875" />
        <parent link="main_body" />
        <child link="standoff_rod_4" />
    </joint>

    <!-- Wheels -->

    <link name="drive_wheel_left">
        <visual>
        <origin rpy="0 1.5707 1.5707" xyz="0 0 0"/>
            <geometry>
                <cylinder radius="0.0352" length="0.0206"/>
            </geometry>
            <material name="black"/>
        </visual>
        <collision>
            <origin rpy="0 1.5707 1.5707" xyz="0 0 0"/>
            <geometry>
                <cylinder radius="0.0352" length="0.0206"/>
            </geometry>
        </collision>
        <inertial>
            <mass value="0.01"/>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <inertia ixx="0.000003451" ixy="0" ixz="0" iyy="0.000003451" iyz="0" izz="0.000006195"/>
        </inertial>
    </link>

    <gazebo reference="drive_wheel_left">
        <collision>
            <surface>
            <friction>
                <ode>
                <mu>10.0</mu>
                <mu2>10.0</mu2>
                </ode>
            </friction>
            <contact>
                <ode>
                <kp>1000000000000000000000000000.0</kp>
                <kd>1000000000000000000000000000.0</kd>
                </ode>
            </contact>
            </surface>
        </collision>
    </gazebo>

    <joint name="joint_drive_wheel_left" type="continuous">
        <origin xyz="0 0.128 -0.0775" rpy="0 0 0"/>
        <parent link="main_body"/>
        <child link="drive_wheel_left"/>
        <axis rpy="0 0 0" xyz="0 1 0"/>
        <limit effort="10000" velocity="1000"/>
        <joint_properties damping="1.0" friction="1.0"/>
    </joint>

    <link name="drive_wheel_right">
        <visual>
        <origin rpy="0 1.5707 1.5707" xyz="0 0 0"/>
            <geometry>
                <cylinder radius="0.0352" length="0.0206"/>
            </geometry>
            <material name="black"/>
        </visual>
        <collision>
            <origin rpy="0 1.5707 1.5707" xyz="0 0 0"/>
            <geometry>
                <cylinder radius="0.0352" length="0.0206"/>
            </geometry>
        </collision>
        <inertial>
            <mass value="0.01"/>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <inertia ixx="0.000003451" ixy="0" ixz="0" iyy="0.000003451" iyz="0" izz="0.000006195"/>
        </inertial>
    </link>

    <gazebo reference="drive_wheel_right">
        <collision>
            <surface>
            <friction>
                <ode>
                <mu>10.0</mu>
                <mu2>10.0</mu2>
                </ode>
            </friction>
            <contact>
                <ode>
                <kp>1000000000000000000000000000.0</kp>
                <kd>1000000000000000000000000000.0</kd>
                </ode>
            </contact>
            </surface>
        </collision>
    </gazebo>

    <joint name="joint_drive_wheel_right" type="continuous">
        <origin xyz="0 -0.128 -0.0775" rpy="0 0 0"/>
        <parent link="main_body"/>
        <child link="drive_wheel_right"/>
        <axis rpy="0 0 0" xyz="0 1 0"/>
        <limit effort="10000" velocity="1000"/>
        <joint_properties damping="1.0" friction="1.0"/>
    </joint>

    <!-- Caster Wheel Front -->

    <link name="front_yaw_link">
        <visual>
            <origin rpy="0 1.5707 1.5707" xyz="0 0 0"/>
            <geometry>
                <cylinder length="0.005" radius="0.0352"/>
            </geometry>
            <material name="black"/>
        </visual>

        <collision>
            <origin rpy="0 1.5707 1.5707" xyz="0 0 0"/>
            <geometry>
                <cylinder length="0.005" radius="0.0352"/>
            </geometry>
        </collision>

        <inertial>
            <mass value="0.01"/>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <inertia ixx="0.0000031184" ixy="0" ixz="0" iyy="0.0000031184" iyz="0" izz="0.000006195"/>
        </inertial>
    </link>

    <joint name="front_yaw_joint" type="continuous">
        <origin xyz="0.12 0 -0.0775" rpy="0 0 0"/>
        <parent link="main_body"/>
        <child link="front_yaw_link"/>
        <axis xyz="0 0 1" />
        <limit effort="1000.0" velocity="100.0" />
        <dynamics damping="0.0" friction="0.1"/>
    </joint>

    <link name="front_roll_link">
         <visual>
            <origin rpy="0 1.5707 1.5707" xyz="0 0 0"/>
            <geometry>
                <cylinder length="0.005" radius="0.0352"/>
            </geometry>
            <material name="black"/>
        </visual>

        <collision>
            <origin rpy="0 1.5707 1.5707" xyz="0 0 0"/>
            <geometry>
                <cylinder length="0.005" radius="0.0352"/>
            </geometry>
        </collision>

        <inertial>
            <mass value="0.01"/>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <inertia ixx="0.0000031184" ixy="0" ixz="0" iyy="0.0000031184" iyz="0" izz="0.000006195"/>
        </inertial>
    </link>

    <joint name="front_roll_joint" type="continuous">
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <parent link="front_yaw_link"/>
        <child link="front_roll_link"/>
        <axis xyz="1 0 0" />
        <limit effort="1000.0" velocity="100.0" />
        <dynamics damping="0.0" friction="0.1"/>
    </joint>

    <link name="front_pitch_link">
        <visual>
            <origin rpy="0 1.5707 1.5707" xyz="0 0 0"/>
            <geometry>
                <sphere radius="0.0352"/>
            </geometry>
            <material name="black"/>
        </visual>

        <collision>
            <origin rpy="0 1.5707 1.5707" xyz="0 0 0"/>
            <geometry>
                <sphere radius="0.0352"/>
            </geometry>
        </collision>

        <inertial>
            <mass value="0.01"/>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <inertia ixx="0.00000826" ixy="0" ixz="0" iyy="00.00000826" iyz="0" izz="0.00000826"/>
        </inertial>
    </link>

    <gazebo reference="front_pitch_link">
        <collision>
            <surface>
            <friction>
                <ode>
                <mu>0.1</mu>
                <mu2>0.1</mu2>
                </ode>
            </friction>
            <contact>
                <ode>
                <kp>1000000000000000000000000000.0</kp>
                <kd>1000000000000000000000000000.0</kd>
                </ode>
            </contact>
            </surface>
        </collision>
    </gazebo>

    <joint name="front_pitch_joint" type="continuous">
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <parent link="front_roll_link"/>
        <child link="front_pitch_link"/>
        <axis xyz="0 1 0" />
        <limit effort="1000.0" velocity="100.0" />
        <dynamics damping="0.0" friction="0.1"/>
    </joint>

    <!-- Caster Wheel Back -->

    <link name="back_yaw_link">
        <visual>
            <origin rpy="0 1.5707 1.5707" xyz="0 0 0"/>
            <geometry>
                <cylinder length="0.005" radius="0.0352"/>
            </geometry>
            <material name="black"/>
        </visual>

        <collision>
            <origin rpy="0 1.5707 1.5707" xyz="0 0 0"/>
            <geometry>
                <cylinder length="0.005" radius="0.0352"/>
            </geometry>
        </collision>

        <inertial>
            <mass value="0.01"/>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <inertia ixx="0.0000031184" ixy="0" ixz="0" iyy="0.0000031184" iyz="0" izz="0.000006195"/>
        </inertial>
    </link>

    <joint name="back_yaw_joint" type="continuous">
        <origin xyz="-0.12 0 -0.0775" rpy="0 0 0"/>
        <parent link="main_body"/>
        <child link="back_yaw_link"/>
        <axis xyz="0 0 1" />
        <limit effort="1000.0" velocity="100.0" />
        <dynamics damping="0.0" friction="0.1"/>
    </joint>

    <link name="back_roll_link">
        <visual>
            <origin rpy="0 1.5707 1.5707" xyz="0 0 0"/>
            <geometry>
                <cylinder length="0.005" radius="0.0352"/>
            </geometry>
            <material name="black"/>
        </visual>

        <collision>
            <origin rpy="0 1.5707 1.5707" xyz="0 0 0"/>
            <geometry>
                <cylinder length="0.005" radius="0.0352"/>
            </geometry>
        </collision>

        <inertial>
            <mass value="0.01"/>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <inertia ixx="0.0000031184" ixy="0" ixz="0" iyy="0.0000031184" iyz="0" izz="0.000006195"/>
        </inertial>
    </link>

    <joint name="back_roll_joint" type="continuous">
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <parent link="back_yaw_link"/>
        <child link="back_roll_link"/>
        <axis xyz="1 0 0" />
        <limit effort="1000.0" velocity="100.0" />
        <dynamics damping="0.0" friction="0.1"/>
    </joint>

    <link name="back_pitch_link">
        <visual>
            <origin rpy="0 1.5707 1.5707" xyz="0 0 0"/>
            <geometry>
                <sphere radius="0.0352"/>
            </geometry>
            <material name="black"/>
        </visual>

        <collision>
            <origin rpy="0 1.5707 1.5707" xyz="0 0 0"/>
            <geometry>
                <sphere radius="0.0352"/>
            </geometry>
        </collision>

        <inertial>
            <mass value="0.01"/>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <inertia ixx="0.00000826" ixy="0" ixz="0" iyy="00.00000826" iyz="0" izz="0.00000826"/>
        </inertial>
    </link>

    <gazebo reference="back_pitch_link">
        <collision>
            <surface>
            <friction>
                <ode>
                <mu>0.1</mu>
                <mu2>0.1</mu2>
                </ode>
            </friction>
            <contact>
                <ode>
                <kp>1000000000000000000000000000.0</kp>
                <kd>1000000000000000000000000000.0</kd>
                </ode>
            </contact>
            </surface>
        </collision>
    </gazebo>

    <joint name="back_pitch_joint" type="continuous">
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <parent link="back_roll_link"/>
        <child link="back_pitch_link"/>
        <axis xyz="0 1 0" />
        <limit effort="1000.0" velocity="100.0" />
        <dynamics damping="0.0" friction="0.1"/>
    </joint>

    <!-- Laser Link -->
    <link name="laser_scan_link">
        <visual>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <geometry>
                <mesh filename="package://barista_robot_description/meshes/slamtec_rplidar_s1.dae" scale="1.0 1.0 1.0"/>
            </geometry>
        </visual>

        <collision>
            <origin rpy="0 0 0" xyz="0 0 0.0204"/>
            <geometry>
                <box size="0.074986 0.074935 0.0408"/>
            </geometry>
        </collision>

        <inertial>
            <mass value="0.01"/>
            <origin rpy="0 0 0" xyz="0 0 0.0204"/>
            <inertia ixx="6.066578520833334e-06" ixy="0" ixz="0" iyy="6.072950163333333e-06" iyz="0" izz="9.365128684166666e-06"/>
        </inertial>
    </link>

    <joint name="laser_scan_link_joint" type="fixed">
        <origin rpy="0 0 0" xyz="0.1 0.0 0.0775"/>
        <parent link="main_body"/>
        <child link="laser_scan_link"/>
    </joint>  

    <link name="laser_scan_frame">
    </link>

    <!-- Joint connecting Laser Scan Link to Laser Scan Frame -->
    <joint name="laser_scan_frame_joint" type="fixed">
        <origin rpy="0 0 0" xyz="0 0 0.03"/>
        <parent link="laser_scan_link"/>
        <child link="laser_scan_frame"/>
        <axis xyz="0 0 0"/>
    </joint>

    <!-- PLUGINS -->

    <!-- Joint State Publisher Plugin -->
    <gazebo>
        <plugin filename="gz-sim-joint-state-publisher-system"
                name="gz::sim::systems::JointStatePublisher">
            <topic>/joint_states</topic>
            <update_rate>30</update_rate>
            <!-- Publish the state of these joints -->
            <joint_name>joint_drive_wheel_left</joint_name>
            <joint_name>joint_drive_wheel_right</joint_name>
            <joint_name>front_yaw_joint</joint_name>
            <joint_name>back_yaw_joint</joint_name>
            <joint_name>front_roll_joint</joint_name>
            <joint_name>back_roll_joint</joint_name>
            <joint_name>front_pitch_joint</joint_name>
            <joint_name>back_pitch_joint</joint_name>
        </plugin>
    </gazebo>  

    <!-- Differential Drive Plugin -->
    <gazebo>
        <plugin
            filename="gz-sim-diff-drive-system"
            name="gz::sim::systems::DiffDrive">
            <left_joint>joint_drive_wheel_left</left_joint>
            <right_joint>joint_drive_wheel_right</right_joint>
            <wheel_separation>0.256</wheel_separation>
            <wheel_radius>0.0352</wheel_radius>
            <topic>cmd_vel</topic>
            <publish_odom>true</publish_odom>
            <publish_odom_tf>true</publish_odom_tf>
            <publish_wheel_tf>true</publish_wheel_tf>
            <odom_topic>odom</odom_topic>
            <tf_topic>tf</tf_topic>
            <frame_id>odom</frame_id>
            <child_frame_id>base_link</child_frame_id>
        </plugin>
    </gazebo>

    <!-- Enable Sensors in Gazebo Sim -->
        <gazebo>
            <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
                <!-- use ogre2 if ogre v2.x is installed, otherwise use ogre -->
                <render_engine>ogre2</render_engine>
            </plugin>
        </gazebo>

        <!-- Laser Scanner Plugin -->
        <gazebo reference="laser_scan_frame">
            <sensor type="gpu_lidar" name="gpu_lidar">
                <pose relative_to='laser_scan_frame'>0 0 0 0 0 0</pose>
                <gz_frame_id>laser_scan_frame</gz_frame_id>
                <always_on>1</always_on>
                <visualize>true</visualize>
                <update_rate>30</update_rate>
                <topic>scan</topic>
                <ray>
                    <scan>
                        <horizontal>
                            <samples>200</samples>
                            <resolution>1</resolution>
                            <min_angle>-3.14</min_angle>
                            <max_angle>3.14</max_angle>
                        </horizontal>
                    </scan>
                    <range>
                        <min>0.1</min>
                        <max>5.0</max>
                        <resolution>0.01</resolution>
                    </range>
                </ray>
            </sensor>
        </gazebo>

</robot>