<?xml version="1.0"?>
<robot name="barista_robot">

        <material name="blue">
            <color rgba="0.0 0.0 1.0 1"/>
        </material>

        <material name="black">
            <color rgba="0.0 0.0 0.0 1"/>
        </material>

        <material name="grey">
            <color rgba="0.75 0.75 0.75 1"/>
        </material>

    <link name="base_link">
    </link>

    <!-- Body -->

    <link name="main_body">
        <visual>
            <geometry>
                <cylinder radius="0.178" length="0.155"/>
            </geometry>
            <material name="blue"/>
        </visual>
        <collision>
            <geometry>
                <cylinder radius="0.178" length="0.155"/>
            </geometry>
        </collision>
        <inertial>
            <mass value="0.5"/>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <inertia ixx="0.004962" ixy="0" ixz="0" iyy="0.004962" iyz="0" izz="0.007921"/>
        </inertial>
    </link>

    <joint name="base_link_to_main_joint" type="fixed">
        <origin rpy="0 0 0" xyz="0 0 0" />
        <parent link="base_link" />
        <child link="main_body" />
    </joint>

    <link name="cup_holder_tray">
        <visual>
            <geometry>
                <cylinder radius="0.16" length=".09"/>
            </geometry>
            <material name="blue"/>
        </visual>
        <collision>
            <geometry>
                <cylinder radius="0.16" length=".09"/>
            </geometry>
        </collision>
        <inertial>
            <mass value="0.25"/>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <inertia ixx="0.0017688" ixy="0" ixz="0" iyy="0.0017688" iyz="0" izz="0.0032"/>
        </inertial>
    </link>

    <joint name="main_link_to_cup_joint" type="fixed">
        <origin rpy="0 0 0" xyz="0 0 0.3425" />
        <parent link="main_body" />
        <child link="cup_holder_tray" />
    </joint>

    <link name="standoff_rod_1">
        <visual>
            <geometry>
                <cylinder radius=".01" length=".220"/>
            </geometry>
            <material name="grey"/>
        </visual>
        <collision>
            <geometry>
                <cylinder radius=".01" length=".220"/>
            </geometry>
        </collision>
        <inertial>
            <mass value="0.075"/>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <inertia ixx="0.0003044" ixy="0" ixz="0" iyy="0.0003044" iyz="0" izz="0.00000375"/>
        </inertial>
    </link>

    <joint name="main_link_to_rod1_joint" type="fixed">
        <origin rpy="0 0 0" xyz="0.06 0.10 0.1875" />
        <parent link="main_body" />
        <child link="standoff_rod_1" />
    </joint>

    <link name="standoff_rod_2">
        <visual>
            <geometry>
                <cylinder radius=".01" length=".220"/>
            </geometry>
            <material name="grey"/>
        </visual>
        <collision>
            <geometry>
                <cylinder radius=".01" length=".220"/>
            </geometry>
        </collision>
        <inertial>
            <mass value="0.075"/>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <inertia ixx="0.0003044" ixy="0" ixz="0" iyy="0.0003044" iyz="0" izz="0.00000375"/>
        </inertial>
    </link>

    <joint name="main_link_to_rod2_joint" type="fixed">
        <origin rpy="0 0 0" xyz="-0.06 0.10 0.1875" />
        <parent link="main_body" />
        <child link="standoff_rod_2" />
    </joint>

    <link name="standoff_rod_3">
        <visual>
            <geometry>
                <cylinder radius=".01" length=".220"/>
            </geometry>
            <material name="grey"/>
        </visual>
        <collision>
            <geometry>
                <cylinder radius=".01" length=".220"/>
            </geometry>
        </collision>
        <inertial>
            <mass value="0.075"/>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <inertia ixx="0.0003044" ixy="0" ixz="0" iyy="0.0003044" iyz="0" izz="0.00000375"/>
        </inertial>
    </link>

    <joint name="main_link_to_rod3_joint" type="fixed">
        <origin rpy="0 0 0" xyz="-0.06 -0.10 0.1875" />
        <parent link="main_body" />
        <child link="standoff_rod_3" />
    </joint>

    <link name="standoff_rod_4">
        <visual>
            <geometry>
                <cylinder radius=".01" length=".220"/>
            </geometry>
            <material name="grey"/>
        </visual>
        <collision>
            <geometry>
                <cylinder radius=".01" length=".220"/>
            </geometry>
        </collision>
        <inertial>
            <mass value="0.075"/>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <inertia ixx="0.0003044" ixy="0" ixz="0" iyy="0.0003044" iyz="0" izz="0.00000375"/>
        </inertial>
    </link>

    <joint name="main_link_to_rod4_joint" type="fixed">
        <origin rpy="0 0 0" xyz="0.06 -0.10 0.1875" />
        <parent link="main_body" />
        <child link="standoff_rod_4" />
    </joint>

    <!-- Wheels -->

    <link name="drive_wheel_left">
        <visual>
        <origin rpy="0 1.5707 1.5707" xyz="0 0 0"/>
            <geometry>
                <cylinder radius="0.0352" length="0.0206"/>
            </geometry>
            <material name="black"/>
        </visual>
        <collision>
            <origin rpy="0 1.5707 1.5707" xyz="0 0 0"/>
            <geometry>
                <cylinder radius="0.0352" length="0.0206"/>
            </geometry>
        </collision>
        <inertial>
            <mass value="0.05"/>
            <origin rpy="0 1.5707 1.5707" xyz="0 0 0"/>
            <inertia ixx="0.000017256" ixy="0" ixz="0" iyy="0.000017256" iyz="0" izz="0.000030976"/>
        </inertial>
    </link>

    <gazebo reference="drive_wheel_left">
        <collision>
            <surface>
            <friction>
                <ode>
                <mu>10.0</mu>
                <mu2>10.0</mu2>
                </ode>
            </friction>
            <contact>
                <ode>
                <kp>10000000.0</kp>
                <kd>10000000.0</kd>
                </ode>
            </contact>
            </surface>
        </collision>
    </gazebo>

    <joint name="joint_drive_wheel_left" type="continuous">
        <origin xyz="0 0.11 -0.0523" rpy="0 0 0"/>
        <parent link="main_body"/>
        <child link="drive_wheel_left"/>
        <axis rpy="0 0 0" xyz="0 1 0"/>
        <limit effort="10000" velocity="1000"/>
        <joint_properties damping="1.0" friction="1.0"/>
    </joint>

    <link name="drive_wheel_right">
        <visual>
        <origin rpy="0 1.5707 1.5707" xyz="0 0 0"/>
            <geometry>
                <cylinder radius="0.0352" length="0.0206"/>
            </geometry>
            <material name="black"/>
        </visual>
        <collision>
            <origin rpy="0 1.5707 1.5707" xyz="0 0 0"/>
            <geometry>
                <cylinder radius="0.0352" length="0.0206"/>
            </geometry>
        </collision>
        <inertial>
            <mass value="0.05"/>
            <origin rpy="0 1.5707 1.5707" xyz="0 0 0"/>
            <inertia ixx="0.000017256" ixy="0" ixz="0" iyy="0.000017256" iyz="0" izz="0.000030976"/>
        </inertial>
    </link>

    <gazebo reference="drive_wheel_right">
        <collision>
            <surface>
            <friction>
                <ode>
                <mu>10.0</mu>
                <mu2>10.0</mu2>
                </ode>
            </friction>
            <contact>
                <ode>
                <kp>10000000.0</kp>
                <kd>10000000.0</kd>
                </ode>
            </contact>
            </surface>
        </collision>
    </gazebo>

    <joint name="joint_drive_wheel_right" type="continuous">
        <origin xyz="0 -0.11 -0.0523" rpy="0 0 0"/>
        <parent link="main_body"/>
        <child link="drive_wheel_right"/>
        <axis rpy="0 0 0" xyz="0 1 0"/>
        <limit effort="10000" velocity="1000"/>
        <joint_properties damping="1.0" friction="1.0"/>
    </joint>

    <!-- Caster Wheel Front -->

    <link name="front_yaw_link">
        <visual>
            <origin rpy="0 1.5707 1.5707" xyz="0 0 0"/>
            <geometry>
                <cylinder length="0.001" radius="0.0045000000000000005"/>
            </geometry>
            <material name="black"/>
        </visual>

        <collision>
            <origin rpy="0 1.5707 1.5707" xyz="0 0 0"/>
            <geometry>
                <cylinder length="0.001" radius="0.0045000000000000005"/>
            </geometry>
        </collision>

        <inertial>
            <origin rpy="0 1.5707 1.5707" xyz="0 0 0"/>
            <mass value="0.001"/>
            <inertia ixx="5.145833333333334e-09" ixy="0" ixz="0" iyy="5.145833333333334e-09" iyz="0" izz="1.0125000000000003e-08"/>
        </inertial>
    </link>

    <joint name="front_yaw_joint" type="continuous">
        <origin xyz="0.11 0 -0.0775" rpy="0 0 0"/>
        <parent link="main_body"/>
        <child link="front_yaw_link"/>
        <axis xyz="0 0 1" />
        <limit effort="1000.0" velocity="100.0" />
        <dynamics damping="0.0" friction="0.1"/>
    </joint>

    <link name="front_roll_link">
         <visual>
            <origin rpy="0 1.5707 1.5707" xyz="0 0 0"/>
            <geometry>
                <cylinder length="0.001" radius="0.0045000000000000005"/>
            </geometry>
            <material name="black"/>
        </visual>

        <collision>
            <origin rpy="0 1.5707 1.5707" xyz="0 0 0"/>
            <geometry>
                <cylinder length="0.001" radius="0.0045000000000000005"/>
            </geometry>
        </collision>

        <inertial>
            <origin rpy="0 1.5707 1.5707" xyz="0 0 0"/>
            <mass value="0.001"/>
            <inertia ixx="5.145833333333334e-09" ixy="0" ixz="0" iyy="5.145833333333334e-09" iyz="0" izz="1.0125000000000003e-08"/>
        </inertial>
    </link>

    <joint name="front_roll_joint" type="continuous">
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <parent link="front_yaw_link"/>
        <child link="front_roll_link"/>
        <axis xyz="1 0 0" />
        <limit effort="1000.0" velocity="100.0" />
        <dynamics damping="0.0" friction="0.1"/>
    </joint>

    <link name="front_pitch_link">
        <visual>
            <origin rpy="0 1.5707 1.5707" xyz="0 0 0"/>
            <geometry>
                <sphere radius="0.01"/>
            </geometry>
            <material name="black"/>
        </visual>

        <collision>
            <origin rpy="0 1.5707 1.5707" xyz="0 0 0"/>
            <geometry>
                <sphere radius="0.01"/>
            </geometry>
        </collision>

        <inertial>
            <origin rpy="0 1.5707 1.5707" xyz="0 0 0"/>
            <mass value="0.001"/>
            <inertia ixx="4e-08" ixy="0" ixz="0" iyy="4e-08" iyz="0" izz="4e-08"/>
        </inertial>
    </link>

    <gazebo reference="front_pitch_link">
        <collision>
            <surface>
            <friction>
                <ode>
                <mu>0.5</mu>
                <mu2>0.5</mu2>
                </ode>
            </friction>
            <contact>
                <ode>
                <kp>10000000.0</kp>
                <kd>10000000.0</kd>
                </ode>
            </contact>
            </surface>
        </collision>
    </gazebo>

    <joint name="front_pitch_joint" type="continuous">
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <parent link="front_roll_link"/>
        <child link="front_pitch_link"/>
        <axis xyz="0 1 0" />
        <limit effort="1000.0" velocity="100.0" />
        <dynamics damping="0.0" friction="0.1"/>
    </joint>

    <!-- Caster Wheel Back -->

    <link name="back_yaw_link">
        <visual>
            <origin rpy="0 1.5707 1.5707" xyz="0 0 0"/>
            <geometry>
                <cylinder length="0.001" radius="0.0045000000000000005"/>
            </geometry>
            <material name="black"/>
        </visual>

        <collision>
            <origin rpy="0 1.5707 1.5707" xyz="0 0 0"/>
            <geometry>
                <cylinder length="0.001" radius="0.0045000000000000005"/>
            </geometry>
        </collision>

        <inertial>
            <origin rpy="0 1.5707 1.5707" xyz="0 0 0"/>
            <mass value="0.001"/>
            <inertia ixx="5.145833333333334e-09" ixy="0" ixz="0" iyy="5.145833333333334e-09" iyz="0" izz="1.0125000000000003e-08"/>
        </inertial>
    </link>

    <joint name="back_yaw_joint" type="continuous">
        <origin xyz="-0.11 0 -0.0775" rpy="0 0 0"/>
        <parent link="main_body"/>
        <child link="back_yaw_link"/>
        <axis xyz="0 0 1" />
        <limit effort="1000.0" velocity="100.0" />
        <dynamics damping="0.0" friction="0.1"/>
    </joint>

    <link name="back_roll_link">
        <visual>
            <origin rpy="0 1.5707 1.5707" xyz="0 0 0"/>
            <geometry>
                <cylinder length="0.001" radius="0.0045000000000000005"/>
            </geometry>
            <material name="black"/>
        </visual>

        <collision>
            <origin rpy="0 1.5707 1.5707" xyz="0 0 0"/>
            <geometry>
                <cylinder length="0.001" radius="0.0045000000000000005"/>
            </geometry>
        </collision>

        <inertial>
            <origin rpy="0 1.5707 1.5707" xyz="0 0 0"/>
            <mass value="0.001"/>
            <inertia ixx="5.145833333333334e-09" ixy="0" ixz="0" iyy="5.145833333333334e-09" iyz="0" izz="1.0125000000000003e-08"/>
        </inertial>
    </link>

    <joint name="back_roll_joint" type="continuous">
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <parent link="back_yaw_link"/>
        <child link="back_roll_link"/>
        <axis xyz="1 0 0" />
        <limit effort="1000.0" velocity="100.0" />
        <dynamics damping="0.0" friction="0.1"/>
    </joint>

    <link name="back_pitch_link">
        <visual>
            <origin rpy="0 1.5707 1.5707" xyz="0 0 0"/>
            <geometry>
                <sphere radius="0.01"/>
            </geometry>
            <material name="black"/>
        </visual>

        <collision>
            <origin rpy="0 1.5707 1.5707" xyz="0 0 0"/>
            <geometry>
                <sphere radius="0.01"/>
            </geometry>
        </collision>

        <inertial>
            <origin rpy="0 1.5707 1.5707" xyz="0 0 0"/>
            <mass value="0.001"/>
            <inertia ixx="4e-08" ixy="0" ixz="0" iyy="4e-08" iyz="0" izz="4e-08"/>
        </inertial>
    </link>

    <gazebo reference="back_pitch_link">
        <collision>
            <surface>
            <friction>
                <ode>
                <mu>0.5</mu>
                <mu2>0.5</mu2>
                </ode>
            </friction>
            <contact>
                <ode>
                <kp>10000000.0</kp>
                <kd>10000000.0</kd>
                </ode>
            </contact>
            </surface>
        </collision>
    </gazebo>

    <joint name="back_pitch_joint" type="continuous">
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <parent link="back_roll_link"/>
        <child link="back_pitch_link"/>
        <axis xyz="0 1 0" />
        <limit effort="1000.0" velocity="100.0" />
        <dynamics damping="0.0" friction="0.1"/>
    </joint>

</robot>