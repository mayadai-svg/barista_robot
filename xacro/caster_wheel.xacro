<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="caster_wheel" params="location parent origin_xyz">
    <!-- Yaw Link -->
    <link name="${location}_yaw_link">
      <visual>
        <origin rpy="0 1.5707 1.5707" xyz="0 0 0"/>
        <geometry><cylinder length="0.001" radius="0.0045"/></geometry>
        <material name="black"/>
      </visual>
      <collision>
        <origin rpy="0 1.5707 1.5707" xyz="0 0 0"/>
        <geometry><cylinder length="0.001" radius="0.0045"/></geometry>
      </collision>
      <inertial>
        <origin rpy="0 1.5707 1.5707" xyz="0 0 0"/>
        <mass value="0.001"/>
        <inertia ixx="5.145e-09" ixy="0" ixz="0" iyy="5.145e-09" iyz="0" izz="1.0125e-08"/>
      </inertial>
    </link>

    <joint name="${location}_yaw_joint" type="continuous">
      <origin xyz="${origin_xyz}" rpy="0 0 0"/>
      <parent link="${parent}"/>
      <child link="${location}_yaw_link"/>
      <axis xyz="0 0 1"/>
      <limit effort="1000.0" velocity="100.0"/>
      <dynamics damping="0.0" friction="0.1"/>
    </joint>

    <!-- Roll Link -->
    <link name="${location}_roll_link">
      <visual>
        <origin rpy="0 1.5707 1.5707" xyz="0 0 0"/>
        <geometry><cylinder length="0.001" radius="0.0045"/></geometry>
        <material name="black"/>
      </visual>
      <collision>
        <origin rpy="0 1.5707 1.5707" xyz="0 0 0"/>
        <geometry><cylinder length="0.001" radius="0.0045"/></geometry>
      </collision>
      <inertial>
        <origin rpy="0 1.5707 1.5707" xyz="0 0 0"/>
        <mass value="0.001"/>
        <inertia ixx="5.145e-09" ixy="0" ixz="0" iyy="5.145e-09" iyz="0" izz="1.0125e-08"/>
      </inertial>
    </link>

    <joint name="${location}_roll_joint" type="continuous">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <parent link="${location}_yaw_link"/>
      <child link="${location}_roll_link"/>
      <axis xyz="1 0 0"/>
      <limit effort="1000.0" velocity="100.0"/>
      <dynamics damping="0.0" friction="0.1"/>
    </joint>

    <!-- Pitch Link (Sphere Contact) -->
    <link name="${location}_pitch_link">
      <visual>
        <origin rpy="0 1.5707 1.5707" xyz="0 0 0"/>
        <geometry><sphere radius="0.01"/></geometry>
        <material name="black"/>
      </visual>
      <collision>
        <origin rpy="0 1.5707 1.5707" xyz="0 0 0"/>
        <geometry><sphere radius="0.01"/></geometry>
      </collision>
      <inertial>
        <origin rpy="0 1.5707 1.5707" xyz="0 0 0"/>
        <mass value="0.001"/>
        <inertia ixx="4e-08" ixy="0" ixz="0" iyy="4e-08" iyz="0" izz="4e-08"/>
      </inertial>
    </link>

    <gazebo reference="${location}_pitch_link">
      <collision>
        <surface>
          <friction><ode><mu>0.5</mu><mu2>0.5</mu2></ode></friction>
          <contact><ode><kp>10000000.0</kp><kd>10000000.0</kd></ode></contact>
        </surface>
      </collision>
    </gazebo>

    <joint name="${location}_pitch_joint" type="continuous">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <parent link="${location}_roll_link"/>
      <child link="${location}_pitch_link"/>
      <axis xyz="0 1 0"/>
      <limit effort="1000.0" velocity="100.0"/>
      <dynamics damping="0.0" friction="0.1"/>
    </joint>
  </xacro:macro>

</robot>