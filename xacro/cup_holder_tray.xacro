<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Tray Geometry Properties -->
  <xacro:property name="tray_radius" value="0.16"/>
  <xacro:property name="tray_length" value="0.09"/>

  <xacro:macro name="cup_holder_tray" params="parent origin_xyz">
    <link name="cup_holder_tray">
      <visual>
        <geometry><cylinder radius="${tray_radius}" length="${tray_length}"/></geometry>
        <material name="blue"/>
      </visual>
      <collision>
        <geometry><cylinder radius="${tray_radius}" length="${tray_length}"/></geometry>
      </collision>
      <inertial>
        <mass value="0.05"/>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <inertia ixx="0.00035375" ixy="0" ixz="0" iyy="0.00035375" iyz="0" izz="0.00064"/>
      </inertial>
    </link>

    <joint name="main_link_to_cup_joint" type="fixed">
      <origin rpy="0 0 0" xyz="${origin_xyz}"/>
      <parent link="${parent}"/>
      <child link="cup_holder_tray"/>
    </joint>
  </xacro:macro>

</robot>